#!/bin/zsh

# Turn BB proxy on and off.
# Both the lower and upper case variables are set, since tools disagree on
# which one they honor.
# Usage:
#   $ bbproxy     => show status; returns 1 unless the proxy is fully on, so
#                    `bbproxy && git push` only pushes through the proxy
#   $ bbproxy on
#   $ bbproxy off

# Print the proxy status: ON, OFF, or PARTIAL if the variables disagree.
# Return 0 only if ON.
_bbproxy_status() {
    local vars=(http_proxy https_proxy HTTP_PROXY HTTPS_PROXY)
    local v nset=0 values=()
    for v in $vars; do
        [[ -n ${(P)v} ]] && (( nset++ )) && values+=${(P)v}
    done
    values=(${(u)values})
    if (( nset == 0 )); then
        print -P "Proxy: %F{red}OFF%f"
        return 1
    elif (( nset == ${#vars} && ${#values} == 1 )); then
        print -P "Proxy: %F{green}ON%f  %F{8}${values[1]//\%/%%}%f"
    else
        print -P "Proxy: %F{yellow}PARTIAL%f"
        local value unset_str="%F{8}<unset>%f"
        for v in $vars; do
            value=${(P)v}
            print -P "  $v=${${value//\%/%%}:-$unset_str}"
        done
        return 1
    fi
}

bbproxy() {
    case "$*" in
        "")
            _bbproxy_status
            ;;
        on)
            export http{,s}_proxy="http://proxy.bloomberg.com:81"
            export HTTP{,S}_PROXY="http://proxy.bloomberg.com:81"
            ;;
        off)
            unset http{,s}_proxy HTTP{,S}_PROXY
            ;;
        *)
            echo "Usage: bbproxy [on|off]. With no argument, print the proxy status"
            echo "and return 1 unless it is on (so 'bbproxy && git push' works)."
            return 1
            ;;
    esac
}
